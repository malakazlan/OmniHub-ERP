# Copy to .env and fill in. Never commit .env.

# MySQL-compatible connection string. For TLS-only hosts (TiDB Cloud, PlanetScale, Aiven)
# append ?sslaccept=strict. Use ?ssl=false only for a local XAMPP/Docker MySQL.
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/omnihub?sslaccept=strict"

# Random 32+ byte secret used to sign session cookies. Required in production.
JWT_SECRET=""

# Seed admin. Used by `npm run db:seed`. Required; the seed refuses to run without them.
ADMIN_EMAIL="admin@omnihub.app"
ADMIN_PASSWORD=""
